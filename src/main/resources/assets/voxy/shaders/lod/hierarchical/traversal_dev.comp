#version 430 core

//TODO: increase local size
#define LOCAL_SIZE_MSK ((1<<LOCAL_SIZE_BITS)-1)
#define LOCAL_SIZE (1<<LOCAL_SIZE_BITS)
layout(local_size_x=LOCAL_SIZE) in;//, local_size_y=1

#import <voxy:lod/frustum.glsl>

// M9 migration: was a `uniform` UBO. Converted to `readonly buffer` so the
// encoder API's setBuffer (which binds SSBO target) works across backends.
// std140 and std430 produce identical offsets for this struct (no arrays of
// small types; vec4[6] in Frustum is the same in both), so the CPU-side
// writes in uploadUniform() stay byte-for-byte compatible.
layout(binding = SCENE_UNIFORM_BINDING, std430) restrict readonly buffer SceneUniform {
    mat4 VP;
    ivec3 camSecPos;
    uint packedHizSize;
    vec3 camSubSecPos;
    float minSSS;
    Frustum frustum;
    uint renderQueueMaxSize;
    uint frameId;
    uint requestQueueSize;
};

#import <voxy:lod/hierarchical/queue.glsl>
#import <voxy:lod/hierarchical/node.glsl>
#import <voxy:lod/hierarchical/screenspace.glsl>

//SIMPLE_QUEUE(uvec2, requestQueue, REQUEST_QUEUE_BINDING);
layout(binding = REQUEST_QUEUE_BINDING, std430) restrict buffer requestQueueStruct {
    uvec2 requestQueueIndex;
    uvec2[] requestQueue;
};

//SIMPLE_QUEUE(uint, renderQueue, RENDER_QUEUE_BINDING);
layout(binding = RENDER_QUEUE_BINDING, std430) restrict buffer renderQueueStruct {
    uint renderQueueIndex;
    uint[] renderQueue;
};

layout(binding = RENDER_TRACKER_BINDING, std430) restrict writeonly buffer renderTrackerArray {
    uint[] lastRenderFrame;
};

#ifdef HAS_STATISTICS
layout(binding = STATISTICS_BUFFER_BINDING, std430) restrict buffer statisticsBuffer {
    uint traversalCounts[MAX_ITERATIONS];
    uint renderCounts[MAX_ITERATIONS];
};
#endif

void addRequest(inout UnpackedNode node) {
    //printf("Put node decend request");
    if (!hasRequested(node)) {
        if (requestQueueIndex.x < requestQueueSize) {//Soft limit
            uint atomRes = atomicAdd(requestQueueIndex.x, 1);
            if (atomRes < MAX_REQUEST_QUEUE_SIZE) {//Hard limit
                //Mark node as having a request submitted to prevent duplicate submissions
                requestQueue[atomRes] = getRawPos(node);
                markRequested(node);
            }
        }
    }
}

void enqueueChildren(in UnpackedNode node) {
    if (childListIsEmpty(node)) {//Occures in a very rare case/instance so just handle it gracefully
        return;
    }

    uint children = getChildCount(node);
    pushNodesInit(children);
    uint ptr = getChildPtr(node);
    for (int i = 0; i < children; i++) {
        pushNode(ptr+i);
    }
}

void enqueueSelfForRender(in UnpackedNode node) {
    //printf("render %d@[%d,%d,%d]", node.lodLevel, node.pos.x, node.pos.y, node.pos.z);
    if (renderQueueIndex < renderQueueMaxSize) {
        lastRenderFrame[getId(node)] = frameId;
        // hasMesh, not merely !isEmptyMesh. meshPtr has THREE states -- NULL_MESH (0xFFFFFF, "no mesh
        // and none requested"), EMPTY_MESH (0xFFFFFE, "a mesh that draws nothing") and a real id -- and
        // isEmptyMesh only excludes the middle one. Without the hasMesh test a NULL_MESH node writes
        // 0xFFFFFF into renderQueue as though it were a section id, and cmdgen then reads
        // sectionData[0xFFFFFF] out of a 1<<20-entry buffer: a 16x out-of-bounds SSBO read that
        // produces garbage draws rather than a clean hole. Reachable via the not-yet-scattered slot
        // NodeStore.clear() leaves behind.
        if (hasMesh(node) && !isEmptyMesh(node)) {
            uint renderIndex = atomicAdd(renderQueueIndex, 1);
            if (renderIndex < renderQueueMaxSize) {
                renderQueue[renderIndex] = getMesh(node);


                #ifdef HAS_STATISTICS
                atomicAdd(renderCounts[node.lodLevel], 1);
                #endif
            }
        }
    }
}


void traverse(in UnpackedNode node) {
    #ifdef HAS_STATISTICS
    atomicAdd(traversalCounts[node.lodLevel], 1);
    #endif

    //Compute screenspace
    setupScreenspace(node);
    //debugDumpNode(node);

    if (outsideFrustum() || isCulledByHiz()) {
        //printf("culled");
    } else {
        //It is visible, TODO: maybe do a more detailed hiz test? (or make it so that )

        // Empty LOD meshes can still represent non-empty descendants. This is
        // common around oceans/flat surfaces after same-face culling, and
        // accepting the empty parent as terminal leaves large square holes.
        bool emptyMeshNeedsChildren = isEmptyMesh(node) && hasKnownChildren(node);

        // `childListIsEmpty` belongs in this test, not just `hasChildren`.
        //
        // hasChildren() is `childPtr != NULL_NODE`, and EMPTY_QUEUE_ID (0xFFFFFE) SATISFIES it -- a
        // state NodeManager writes deliberately when a node's children reduce to nothing
        // (NodeManager.java:531-548, `setChildPtr(nodeId, SENTINEL_EMPTY_CHILD_PTR)`). But
        // enqueueChildren() opens with `if (childListIsEmpty(node)) return;`, so descending on that
        // sentinel enqueues NOTHING -- and because this branch deliberately does not render the node
        // itself either, the node's entire volume draws nothing that frame, while its mesh is still
        // present and GPU-resident (nothing clears an inner node's geometry).
        //
        // That is a one-frame hole at a detail boundary, and it only appears while MOVING. Whether the
        // node takes this branch at all is `screenSize > minSSS`, so a node sitting at the threshold
        // draws its own mesh on the frames just below it and draws nothing on the frames just above,
        // flipping frame to frame with the camera's sub-pixel motion. A static camera holds screenSize
        // still, the state is stable, and the hole never shows -- which is why this reads as "blips
        // when I move", not as a permanently missing chunk.
        //
        // Rendering self here cannot double-draw: childListIsEmpty means enqueueChildren would have
        // enqueued nothing, so this only ever ADDS the coverage that was missing. A node with an empty
        // child list that genuinely has no mesh still falls through to addRequest + enqueueChildren,
        // exactly as before.
        bool canCoverWithChildren = hasChildren(node) && !childListIsEmpty(node);
        if (node.lodLevel!=0 && (shouldDecend() || emptyMeshNeedsChildren) && canCoverWithChildren) {
            //printf("A");
            enqueueChildren(node);
        } else {
            if (hasMesh(node)) {
                //printf("C");
                enqueueSelfForRender(node);
            } else {
                //printf("D");
                //!! not ideal, we want to render this mesh but dont have it. If we havent sent a request
                // then send a request for a mesh for this node.
                addRequest(node);

                //TODO: Decend into children? maybe add a bitflag saying is bad if the immediate children dont have meshes
                if (node.lodLevel != 0) {
                    enqueueChildren(node);
                }
            }
        }
    }
}

void main() {
    uint nodeId = getCurrentNode();
    if (nodeId != SENTINAL_OUT_OF_BOUNDS) {
        //Fetch + decode node
        UnpackedNode node;
        unpackNode(node, nodeId);

        traverse(node);

