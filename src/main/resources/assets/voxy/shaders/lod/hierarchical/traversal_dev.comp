#import <voxy:lod/frustum.glsl>

// M9 migration: was a `uniform` UBO. Converted to `readonly buffer` so the
// encoder API's setBuffer (which binds SSBO target) works across backends.
// std140 and std430 produce identical offsets for this struct (no arrays of
// small types; vec4[6] in Frustum is the same in both), so the CPU-side
// writes in uploadUniform() stay byte-for-byte compatible.
layout(binding = SCENE_UNIFORM_BINDING, std430) restrict readonly buffer SceneUniform {
    mat4 VP;
    ivec3 camSecPos;
    uint packedHizSize;
    vec3 camSubSecPos;
    float minSSS;
    Frustum frustum;
    uint renderQueueMaxSize;
    uint frameId;
    uint requestQueueSize;
};

#import <voxy:lod/hierarchical/queue.glsl>
#import <voxy:lod/hierarchical/node.glsl>
#import <voxy:lod/hierarchical/screenspace.glsl>

//SIMPLE_QUEUE(uvec2, requestQueue, REQUEST_QUEUE_BINDING);
layout(binding = REQUEST_QUEUE_BINDING, std430) restrict buffer requestQueueStruct {
    uvec2 requestQueueIndex;
    uvec2[] requestQueue;
};

//SIMPLE_QUEUE(uint, renderQueue, RENDER_QUEUE_BINDING);
layout(binding = RENDER_QUEUE_BINDING, std430) restrict buffer renderQueueStruct {
    uint renderQueueIndex;
    uint[] renderQueue;
};

layout(binding = RENDER_TRACKER_BINDING, std430) restrict writeonly buffer renderTrackerArray {
    uint[] lastRenderFrame;
};

#ifdef HAS_STATISTICS
layout(binding = STATISTICS_BUFFER_BINDING, std430) restrict buffer statisticsBuffer {
    uint traversalCounts[MAX_ITERATIONS];
    uint renderCounts[MAX_ITERATIONS];
    // WHY these three exist, per level. The traversal makes four decisions about a node -- culled by
    // frustum, culled by occlusion, handed off to children, drawn -- and until now only two of them were
    // counted. So when geometry goes missing there was no way to tell WHICH gate dropped it: the
    // symptoms of a cull and of a placement bug look identical on screen (absence), and everything that
    // removes a node at node granularity funnels through one of these four lines.
    //
    // Read them as a set. One counter dropping for a frame while the others hold = a gating flicker,
    // and it names the gate. All four steady while geometry is visibly missing = nothing is being
    // culled at all, the nodes are being drawn somewhere else, and the hunt moves to placement --
    // which is a different family entirely and not reachable by staring at the cull.
    uint frustumCulledCounts[MAX_ITERATIONS];
    uint hizCulledCounts[MAX_ITERATIONS];
    uint descendCounts[MAX_ITERATIONS];
    // WHY this one exists. It counts the nodes that WANTED to descend and could not, because at
    // least one child has no mesh yet -- i.e. the geometry that is missing from the screen because it
    // has not been BUILT, not because anything culled it.
    //
    // That distinction is the whole of Bug B and nothing separated the two. A hole from a cull and a
    // hole from an un-meshed node are the same absence on screen; every cull counter reads clean for
    // both, because for the cull counters nothing was culled -- the node was simply never ready. So a
    // frame full of holes with `notReady` high is a STARVATION finding, and the hunt leaves the cull
    // entirely.
    //
    // It is also the natural pair to `descendCounts`: the two together partition the nodes that
    // should have refined, into "did" and "could not".
    uint notReadyCounts[MAX_ITERATIONS];
    // WHAT THE CULL IS ACTING ON, in two histograms, because every remaining hypothesis about the
    // over-culling is a claim about these two numbers and neither has ever been observed.
    //
    // `hizSampleHist` bins `pointSample` -- the depth the pyramid returned, i.e. the farthest occluder
    // over the box's footprint. `hizBoxHist` bins `maxBB.z` -- the box's nearest point. The test is
    // `pointSample > maxBB.z`, so a cull means the sample is NEARER than the box.
    //
    // What the shapes would mean. On reverse-Z near is 1.0 and far is 0.0, and in an outdoor scene at
    // LOD range the depth values are SMALL (depth ~= near/distance, so ~1e-4 at a kilometre):
    //   * culls whose sample sits in the TOP bucket mean the pyramid is reporting an occluder at the
    //     near plane, which cannot be terrain -- the pyramid's content or its mapping is wrong.
    //   * culls whose sample sits LOW and just above the box's own bucket are plausible geometry: a
    //     nearer hill, correctly occluding. That would say the cull is RIGHT and the missing terrain
    //     comes from somewhere else, which is a completely different investigation.
    //   * samples clustered in one bucket across all levels means a constant, not a depth.
    uint hizSampleHist[8];
    uint hizBoxHist[8];
};
#endif

void addRequest(inout UnpackedNode node) {
    //printf("Put node decend request");
    if (!hasRequested(node)) {
        if (requestQueueIndex.x < requestQueueSize) {//Soft limit
            uint atomRes = atomicAdd(requestQueueIndex.x, 1);
            if (atomRes < MAX_REQUEST_QUEUE_SIZE) {//Hard limit
                //Mark node as having a request submitted to prevent duplicate submissions
                requestQueue[atomRes] = getRawPos(node);
                markRequested(node);
            }
        }
    }
}

void enqueueChildren(in UnpackedNode node) {
    if (childListIsEmpty(node)) {//Occures in a very rare case/instance so just handle it gracefully
        return;
    }

    uint children = getChildCount(node);
    pushNodesInit(children);
    uint ptr = getChildPtr(node);
    for (int i = 0; i < children; i++) {
        pushNode(ptr+i);
    }
}

/**
 * Whether EVERY child has a mesh, i.e. whether descending will actually put something on screen.
 *
 * <p>Why this is needed. A node that descends does not render itself -- rendering is leaves-only by
 * design, and drawing parent and children together would z-fight, since both cover the same volume at
 * different tessellation. So the frame rests entirely on the children. A node becomes "inner" (gains
 * children) the moment the world reports they exist, but those children are new graph nodes with no
 * meshes yet, and a mesh takes frames to arrive. In that window the parent is suppressed AND the
 * children draw nothing: a hole.
 *
 * <p>It is worst at the level-1 -> level-0 handover, which is what the user reports: level 0 are the
 * only nodes that never descend (`node.lodLevel != 0` above), so they are terminal, and they are both
 * the most numerous and the most expensive to mesh -- the longest possible wait, at the closest
 * possible range.
 *
 * <p>Only NULL_MESH blocks. EMPTY_MESH is a legitimate state meaning "this node draws nothing, look at
 * its children", so treating it as un-ready would suppress a parent that is correctly handing off to
 * grandchildren, and draw both.
 */
bool childrenCanDraw(in UnpackedNode node) {
    uint childCount = getChildCount(node);
    uint ptr = getChildPtr(node);
    for (uint i = 0u; i < childCount; i++) {
        UnpackedNode child;
        unpackNode(child, ptr + i);
        if (!hasMesh(child)) {
            return false;
        }
    }
    return true;
}

void enqueueSelfForRender(in UnpackedNode node) {
    //printf("render %d@[%d,%d,%d]", node.lodLevel, node.pos.x, node.pos.y, node.pos.z);
    if (renderQueueIndex < renderQueueMaxSize) {
        lastRenderFrame[getId(node)] = frameId;
        // hasMesh, not merely !isEmptyMesh. meshPtr has THREE states -- NULL_MESH (0xFFFFFF, "no mesh
        // and none requested"), EMPTY_MESH (0xFFFFFE, "a mesh that draws nothing") and a real id -- and
        // isEmptyMesh only excludes the middle one. Without the hasMesh test a NULL_MESH node writes
        // 0xFFFFFF into renderQueue as though it were a section id, and cmdgen then reads
        // sectionData[0xFFFFFF] out of a 1<<20-entry buffer: a 16x out-of-bounds SSBO read that
        // produces garbage draws rather than a clean hole. Reachable via the not-yet-scattered slot
        // NodeStore.clear() leaves behind.
        if (hasMesh(node) && !isEmptyMesh(node)) {
            uint renderIndex = atomicAdd(renderQueueIndex, 1);
            if (renderIndex < renderQueueMaxSize) {
                renderQueue[renderIndex] = getMesh(node);


                #ifdef HAS_STATISTICS
                atomicAdd(renderCounts[node.lodLevel], 1);
                #endif
            }
        }
    }
}


void traverse(in UnpackedNode node) {
    #ifdef HAS_STATISTICS
    atomicAdd(traversalCounts[node.lodLevel], 1);
    #endif

    //Compute screenspace
    setupScreenspace(node);
    //debugDumpNode(node);

    // Split, so the two culls can be told apart. Semantics are unchanged -- this is the same
    // short-circuit, written out -- but a node dropped by the frustum and one dropped by occlusion are
    // very different diagnoses and were previously indistinguishable in every counter.
    bool frustumCulledNow = outsideFrustum();
    bool hizCulledNow = !frustumCulledNow && isCulledByHiz();
    if (frustumCulledNow || hizCulledNow) {
        //printf("culled");
        #ifdef HAS_STATISTICS
        if (frustumCulledNow) {
            atomicAdd(frustumCulledCounts[node.lodLevel], 1);
        } else {
            atomicAdd(hizCulledCounts[node.lodLevel], 1);
            // Bin what the decision was made on. The traversal already stashed the pyramid's answer and
            // the box's near edge for this node; this only records where they landed. Guarded on the
            // same statistics flag as everything else, and free when it is off.
            atomicAdd(hizSampleHist[clamp(int(hizLastSample * 8.0), 0, 7)], 1);
            atomicAdd(hizBoxHist[clamp(int(maxBB.z * 8.0), 0, 7)], 1);
        }
        #endif
    } else {
        //It is visible, TODO: maybe do a more detailed hiz test? (or make it so that )

        // Empty LOD meshes can still represent non-empty descendants. This is
        // common around oceans/flat surfaces after same-face culling, and
        // accepting the empty parent as terminal leaves large square holes.
        bool emptyMeshNeedsChildren = isEmptyMesh(node) && hasKnownChildren(node);

        // `childListIsEmpty` belongs in this test, not just `hasChildren`.
        //
        // hasChildren() is `childPtr != NULL_NODE`, and EMPTY_QUEUE_ID (0xFFFFFE) SATISFIES it -- a
        // state NodeManager writes deliberately when a node's children reduce to nothing
        // (NodeManager.java:531-548, `setChildPtr(nodeId, SENTINEL_EMPTY_CHILD_PTR)`). But
        // enqueueChildren() opens with `if (childListIsEmpty(node)) return;`, so descending on that
        // sentinel enqueues NOTHING -- and because this branch deliberately does not render the node
        // itself either, the node's entire volume draws nothing that frame, while its mesh is still
        // present and GPU-resident (nothing clears an inner node's geometry).
        //
        // That is a one-frame hole at a detail boundary, and it only appears while MOVING. Whether the
        // node takes this branch at all is `screenSize > minSSS`, so a node sitting at the threshold
        // draws its own mesh on the frames just below it and draws nothing on the frames just above,
        // flipping frame to frame with the camera's sub-pixel motion. A static camera holds screenSize
        // still, the state is stable, and the hole never shows -- which is why this reads as "blips
        // when I move", not as a permanently missing chunk.
        //
        // Rendering self here cannot double-draw: childListIsEmpty means enqueueChildren would have
        // enqueued nothing, so this only ever ADDS the coverage that was missing. A node with an empty
        // child list that genuinely has no mesh still falls through to addRequest + enqueueChildren,
        // exactly as before.
        bool canCoverWithChildren = hasChildren(node) && !childListIsEmpty(node);
        // VOXY_LOD_CHILD_READY=0 restores the old behaviour, where a node descends into children that
        // cannot draw yet and leaves a hole until their meshes arrive. It is the escape hatch.
        #ifndef VOXY_LOD_NO_CHILD_READY
        bool childrenReady = canCoverWithChildren && childrenCanDraw(node);
        #else
        bool childrenReady = canCoverWithChildren;
        #endif
        if (node.lodLevel!=0 && (shouldDecend() || emptyMeshNeedsChildren)) {
            if (childrenReady) {
                //printf("A");
                #ifdef HAS_STATISTICS
                atomicAdd(descendCounts[node.lodLevel], 1);
                #endif
                enqueueChildren(node);
            } else if (canCoverWithChildren) {
                //printf("A'");
                // The node wanted to refine and could not: at least one child has no mesh yet. This is
                // the line that counts as "missing geometry that was never built" (see notReadyCounts).
                #ifdef HAS_STATISTICS
                atomicAdd(notReadyCounts[node.lodLevel], 1);
                #endif
                // Children exist but at least one has no mesh yet, so descending would draw NOTHING for
                // this volume. Cover it with our own mesh until they are ready.
                //
                // enqueueChildren() is still called, and that is load-bearing rather than tidy: the
                // children are only VISITED -- and therefore only ever get requested and meshed -- by
                // being enqueued. Skipping the descent here would leave them unrequested forever, so
                // they would never become ready and the LOD would stick coarse across the world. That
                // is not hypothetical; an earlier attempt at this file's descend branch dropped a
                // request in exactly this way and pinned every node at its coarsest level.
                //
                // No double-draw while they are unready: an unmeshed child renders nothing, so there is
                // no second surface to z-fight with. On the frame they become ready this branch is not
                // taken and the parent stops being drawn, which is the handover the design intends.
                if (!emptyMeshNeedsChildren) {
                    enqueueSelfForRender(node);
                }
                enqueueChildren(node);
            } else {
                //printf("B");
                // Cannot hand off: either no children at all, or a child list enqueueChildren() would
                // decline to walk (EMPTY_QUEUE_ID).
                //
                // addRequest() MUST stay in this branch. It is not a formality. Without it a node that
                // wants to subdivide but has nothing to subdivide INTO never asks for children, so it
                // never gets them, so it draws itself forever -- the LOD sticks at its coarsest level
                // across the entire world. A first attempt at this fix restructured these two branches
                // into one and left the request behind in the no-mesh case; that is exactly what it did,
                // and it was caught by eye, not by a test.
                addRequest(node);
                // Render ourselves meanwhile, so the volume stays covered while the children are built.
                if (!emptyMeshNeedsChildren) {
                    enqueueSelfForRender(node);
                }
            }
        } else {
            if (hasMesh(node)) {
                //printf("C");
                enqueueSelfForRender(node);
            } else {
                //printf("D");
                //!! not ideal, we want to render this mesh but dont have it. If we havent sent a request
                // then send a request for a mesh for this node.
                addRequest(node);

                //TODO: Decend into children? maybe add a bitflag saying is bad if the immediate children dont have meshes
                if (node.lodLevel != 0) {
                    enqueueChildren(node);
                }
            }
        }
    }
}

